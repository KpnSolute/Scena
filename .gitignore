# Local credentials used by the Supabase MCP connection
.env
.env.*
!.env.example

# Supabase CLI state is intentionally not configured by this project setup.
supabase/.temp/
node_modules/
dist/

# TypeScript incremental build cache — regenerated by `tsc -b`, never
# meaningful to commit.
*.tsbuildinfo

# Per-editor MCP configuration. Each writes its own client-specific server
# definition; the committed .mcp.json is the single portable source of truth
# for this project's Supabase MCP connection.
.cursor/
.vscode/
